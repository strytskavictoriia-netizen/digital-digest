# Скопіюйте цей файл у .env і заповніть. Файл .env лишається лише на вашому комп'ютері.

# Канал і бот, що публікує випуски
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Токен підписки Claude — створювати в окремому вікні PowerShell/Terminal:
#   npx @anthropic-ai/claude-code setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# Сторінки Telegraph — команда: python -m digest telegraph-setup
TELEGRAPH_TOKEN=

# Центр агентів (особисті сповіщення) і сторож healthchecks.io
HUB_BOT_TOKEN=
HUB_CHAT_ID=
HEALTHCHECK_URL=

# Лише якщо в config.yaml backend: api
ANTHROPIC_API_KEY=
